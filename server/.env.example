# =========================================================
# CityCare Hospital - backend environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to version control.
# =========================================================

# Runtime environment: "development" or "production"
# In production the server fails closed if admin security config is missing.
NODE_ENV=development

# Port the backend listens on
PORT=3000

# ---------------------------------------------------------
# MongoDB Atlas connection string (Mongoose + session store)
# Paste your cluster's connection string HERE (in server/.env, NOT this file).
# Format: mongodb+srv://<dbUser>:<dbPassword>@<cluster>/<dbname>?retryWrites=true&w=majority
# ---------------------------------------------------------
MONGODB_URI=

# ---------------------------------------------------------
# ADMIN SECURITY (required)
#  - ADMIN_USERNAME: the admin username.
#  - ADMIN_PASSWORD_HASH: a BCRYPT hash of the admin password.
#    Generate one from a strong, unique password, e.g.:
#      node -e "console.log(require('bcryptjs').hashSync('YOUR_STRONG_PASSWORD', 12))"
#    Never use the demo default admin123 in production. The server refuses to
#    start in production without a valid bcrypt ADMIN_PASSWORD_HASH.
#  - SESSION_SECRET: a long random string (>=32 chars) used to sign sessions.
#      node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Session lifetime in minutes (default 480 = 8 hours)
SESSION_TTL_MINUTES=480

# Cookie security. MUST be "true" when serving over HTTPS (production).
COOKIE_SECURE=true

# ---------------------------------------------------------
# CORS - the exact origin(s) allowed to call the API.
# For production set this to your deployed frontend domain ONLY (no localhost).
# Examples:
#   CORS_ORIGIN=https://your-hospital.example.com
#   CORS_ORIGIN=https://a.example.com,https://b.example.com
# ---------------------------------------------------------
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------
# Contact form email - where enquiries are emailed to
# ---------------------------------------------------------
ADMIN_EMAIL=admin@citycare.example
FROM_EMAIL=

# Option A - Generic SMTP (SendGrid / Mailgun / SES / office server)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Option B - Gmail (leave SMTP_HOST blank; use an App Password, NOT your password)
# GMAIL_USER=youraddress@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password

# ---------------------------------------------------------
# DEPLOYMENT CHECKLIST - set ALL of these on your host:
#   NODE_ENV=production
#   PORT (e.g. 8080 or whatever your host listens on)
#   MONGODB_URI
#   ADMIN_USERNAME
#   ADMIN_PASSWORD_HASH   (bcrypt of a strong password)
#   SESSION_SECRET        (>=32 random chars)
#   COOKIE_SECURE=true
#   CORS_ORIGIN           (your real frontend domain only)
#   ADMIN_EMAIL
#   SMTP_* (or GMAIL_*)
# Never put ANY of these in the frontend or commit them to Git.
# ---------------------------------------------------------